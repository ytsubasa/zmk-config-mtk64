            label = "TO0_KP_3";
        };

        to0_kp_4: to0_kp_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp NUMBER_4>;
            label = "TO0_KP_4";
        };

        to0_kp_5: to0_kp_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp N5>;
            label = "TO0_KP_5";
        };

        to0_kp_6: to0_kp_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp NUMBER_6>;
            label = "TO0_KP_6";
        };

        to0_kp_7: to0_kp_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp N7>;
            label = "TO0_KP_7";
        };

        to0_kp_8: to0_kp_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp N8>;
            label = "TO0_KP_8";
        };

        to0_kp_9: to0_kp_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
