            label = "TO0_KP_S";
        };

        to0_kp_E: to0_kp_E {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp E>;
            label = "TO0_KP_E";
        };

        to0_kp_D: to0_kp_D {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp D>;
            label = "TO0_KP_D";
        };

        to0_kp_R: to0_kp_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
