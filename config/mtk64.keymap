        };

        to0_kp_W: to0_kp_W {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp W>;
            label = "TO0_KP_W";
        };

        to0_kp_S: to0_kp_S {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
