#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keycode_japanese.h"

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
    tapping-term-ms = <300>;
};

&mkp_input_listener { input-processors = <&zip_temp_layer 6 5000>; };

/ {
    behaviors {
        // 垂直スクロール用のbehaviorの設定

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        // 水平スクロール用のbehaviorの設定

        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        layer1_tap: layer1_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER1_TAP";
            bindings = <&mo1to0>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        layer4_tap: layer4_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER4_TAP";
            bindings = <&mo4to0>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        to0_z_holdShift: to0_z_holdShift {
            compatible = "zmk,behavior-hold-tap";
            label = "TO0_Z_HOLDSHIFT";
            bindings = <&mo0toShift>, <&to0_kp_Z>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };
    };
};

/ {
    macros {
        lang1_reset: lang1_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANGUAGE_1>;
            label = "LANG1_RESET";
        };

        lang2_reset: lang2_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANGUAGE_2>;
            label = "LANG2_RESET";
        };

        mo1to0: mo1to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_pause_for_release>, <&to 0>;

            label = "mo1to0";
        };

        mo4to0: mo4to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 4>, <&macro_pause_for_release>, <&to 0>;

            label = "MO4TO0";
        };

        to0_kp_ESC: to0_kp_ESC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp ESCAPE>;
            label = "TO0_KP_ESC";
        };

        to0_kp_TAB: to0_kp_TAB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp TAB>;
            label = "TO0_KP_TAB";
        };

        to0_kp_Control: to0_kp_Control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_CONTROL>;
            label = "TO0_KP_CONTROL";
        };

        to0_kp_Shift: to0_kp_Shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_SHIFT>;
            label = "TO0_KP_SHIFT";
        };

        to0_kp_Option: to0_kp_Option {
